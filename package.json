{
  "name": "@siposdani87/expo-rich-text-editor",
  "version": "1.2.1",
  "description": "This rich text editor written in TypeScript and use React Hooks structure. This component use the HTML ContentEditable div feature and React communicate and send data to native JavaScript via WebView.",
  "author": "Dániel Sipos <siposdani87@gmail.com> (https://siposdani87.com)",
  "license": "MIT",
  "homepage": "https://siposdani87.com",
  "private": false,
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "keywords": [
    "expo-rich-text-editor",
    "richtext",
    "editor"
  ],
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siposdani87/expo-rich-text-editor.git"
  },
  "bugs": {
    "url": "https://github.com/siposdani87/expo-rich-text-editor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "npx tsc -p .",
    "clean": "rm -rf dist",
    "lint": "npx eslint . --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "format": "npx prettier --write 'src/**/*.ts*'",
    "prepare": "husky"
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-webview": ">=13.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.21.0",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "expo": "~54.0.33",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.2.4",
    "react": "~19.2.4",
    "react-native": "~0.81.5",
    "react-native-webview": "^13.16.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  }
}
