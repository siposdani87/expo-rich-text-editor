{
  "expo": {
    "name": "expo-rich-text-editor",
    "slug": "expo-rich-text-editor",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siposdani87.expo-rich-text-editor"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.siposdani87.exporichtexteditor"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#ffffff" }],
      "expo-font"
    ]
  }
}
